rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSuperAdmin() {
      return request.auth != null && (request.auth.token.email == 'mahirash9999@gmail.com' || request.auth.token.email == 'admin@mahirash.com');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // OTP Verification security: STRICTLY NO CLIENT ACCESS (handled exclusively by server API)
    match /_otp_verifications/{docId} {
      allow read, write: if false;
    }

    // Products rules: public read, super admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow write: if isSuperAdmin() || request.auth != null;
    }
    
    // Users rules: sub-collections restricted to authenticated owner
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isSuperAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }
    }
    
    // Orders rules: Strict authentication-based access to prevent arbitrary read/writes.
    // Order creation permitted for checkout (guest & authenticated)
    // Order modification restricted exclusively to super admin / server API
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isSuperAdmin() || (
        request.auth != null && (
          request.auth.uid == resource.data.userId || 
          request.auth.token.email == resource.data.userEmail ||
          request.auth.token.email == resource.data.customerEmail
        )
      );
      allow update: if isSuperAdmin() || (
        request.auth != null && 
        (resource.data.isGuest == true || resource.data.userId == null || resource.data.userId == '') &&
        (request.auth.token.email == resource.data.customerEmail || request.auth.token.email == resource.data.userEmail) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isGuest == false
      );
      allow delete: if isSuperAdmin();
    }
    
    // Coupons rules: public read for checkout, super admin write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Customers collection: Strict profile isolation
    match /customers/{customerId} {
      allow read, update: if isSuperAdmin() || (
        request.auth != null && (
          request.auth.token.email == resource.data.email || 
          request.auth.uid == customerId ||
          request.auth.uid == resource.data.uid
        )
      );
      allow create: if true; // allow initial profile creation
      allow delete: if isSuperAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.uid == customerId);
      }
    }

    // CMS & Storefront Dynamic Content Collections: public read, super admin write
    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /shop_by_category/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /mobile_categories/{catId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /benefits_strip/{benefitId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /explore_banner/{bannerId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /global_alerts/{alertId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /promo_popup_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /community_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /community_images/{imageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /community_stats/{statId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /subcategories/{subcatId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /collections/{colId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /attributes/{attrId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Returns & Refunds
    match /returns/{returnId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // Admin Profile & System Logs
    match /admin_profile/{profileId} {
      allow read, write: if isSuperAdmin();
    }

    match /activity_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // Global fallback for any other collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
